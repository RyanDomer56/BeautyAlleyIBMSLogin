{
  "name": "beauty-alley-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Beauty Alley booking system - Express + TypeScript API over Supabase (Postgres, Auth, RLS).",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node dist/local.js",
    "start": "node dist/local.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:plan": "node scripts/migrate.js --dry-run",
    "db:seed": "node scripts/seed.js",
    "db:verify": "node scripts/verify.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "demo:accounts": "node scripts/demo-accounts.js",
    "demo:bookings": "node scripts/seed-demo-bookings.js",
    "smoke": "node scripts/smoke.js",
    "verify:arrival": "node scripts/verify-arrival-pass.js",
    "verify:booking": "node scripts/verify-booking-correctness.js",
    "verify:atomicity": "node scripts/verify-atomicity.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
