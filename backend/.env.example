# ---------------------------------------------------------------------------
# Beauty Alley backend - environment template.
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Supabase project ------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Settings -> API -> Project API keys.
# SUPABASE_ANON_KEY is public by design (it is shipped to browsers).
SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security entirely. Server-side only.
# Never expose this to a client, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres -------------------------------------------------------
# Used ONLY by scripts/migrate.js and the test harness.
# Format: postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# --- Domain rules ----------------------------------------------------------
# Branch local timezone. All timestamps are stored as UTC timestamptz.
BRANCH_TIMEZONE=Asia/Manila

# Cancellations closer than this to the start time are refused.
CANCELLATION_WINDOW_HOURS=2

# --- QR check-in -----------------------------------------------------------
# HMAC-SHA256 key for signing QR payloads. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every outstanding QR pass.
QR_SIGNING_SECRET=

# A pass becomes scannable this many minutes before the appointment starts.
QR_CHECKIN_WINDOW_MINUTES=60

# Where a scanned pass points, once the token is verified.
QR_CHECKIN_URL=https://beautyalley.app/check-in

# The walk-in door QR. A different sticker from the desk check-in QR: this one
# starts a registration, the other redeems an existing pass. BRANCH_ID is the
# branch that sticker belongs to.
BRANCH_ID=beautyalley-main
QR_ENTER_URL=https://beautyalley.app/welcome

# --- Login throttling ------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Public exposure -------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Leave empty while
# the API is local-only (development reflects any origin). Set this the moment
# the API is reachable from the internet - on Vercel it is REQUIRED, because
# the API refuses to boot in production with neither this nor SERVE_APP:
#   ALLOWED_ORIGINS=https://beautyalleyibms.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Serve the built frontend (repo-root dist/) from this process too, so one
# origin carries both the app and the API. That is the self-hosted container
# (see the Dockerfile). Leave it false on Vercel, where the frontend is its own
# service. Off by default: `/` is then the JSON endpoint index.
SERVE_APP=false

# --- Destructive operations ------------------------------------------------
# `npm run db:seed` TRUNCATEs seventeen tables. Set this to 1 ONLY in a
# .env.local that points at a disposable database, to confirm you mean it.
# `NODE_ENV=production` is refused regardless of this flag. Individual runs can
# bypass it with `npm run db:seed -- --force`.
ALLOW_DESTRUCTIVE_SEED=
